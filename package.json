{
  "name": "booky.io",
  "version": "3.2.0",
  "description": "Online bookmarking service with high focus on performance, mobile support and customizability.",
  "homepage": "https://booky.io",
  "email": "hello@booky.io",
  "private": true,
  "jsnext:main": "_source/index.js",
  "engines": {
    "node": ">=18.18",
    "npm": ">=4"
  },
  "scripts": {
    "preinstall": "node tools/nodeVersionCheck.js",
    "start": "npm run open:source",
    "start:ci": "npm run open:source --no-clipboard",
    "open:source": "babel-node tools/srcServer.js",
    "open:public": "babel-node tools/distServer.js",
    "lint": "npm-run-all lint:js lint:format",
    "lint:js": "eslint .",
    "lint:format": "prettier --check .",
    "build:open": "babel-node tools/build.js && npm run open:public",
    "build": "babel-node tools/build.js && npm run prerender",
    "prerender": "babel-node tools/prerender.js",
    "analyze": "babel-node tools/analyzeBundle.js",
    "deploy:backend": "bash tools/deployToBackend.sh",
    "test": "jest",
    "test:cover": "npm run test -- --coverage ",
    "test:watch": "jest --watchAll",
    "qa": "npm-run-all test lint",
    "prettier": "prettier --write .",
    "extensions": "cd extension && ./manifest.sh firefox && ./manifest.sh opera && ./manifest.sh edge && ./manifest.sh chrome",
    "extension:chrome": "cd extension && ./manifest.sh chrome",
    "extension:firefox": "cd extension && ./manifest.sh firefox",
    "extension:opera": "cd extension && ./manifest.sh opera",
    "extension:edge": "cd extension && ./manifest.sh edge"
  },
  "proxy": "http://localhost:8001/",
  "author": "Nico Thiebes",
  "license": "SEE LICENSE IN \"LICENSE\"",
  "dependencies": {
    "@babel/plugin-syntax-dynamic-import": "7.8.3",
    "@hot-loader/react-dom": "17.0.2",
    "@sentry/browser": "6.7.1",
    "abortcontroller-polyfill": "1.7.5",
    "classnames": "2.3.1",
    "connected-react-router": "6.9.3",
    "core-js": "3.21.1",
    "disqus-react": "1.1.5",
    "emoji-regex": "9.2.2",
    "es-cookie": "1.3.2",
    "intersection-observer": "0.12.0",
    "npm-run-all": "4.1.5",
    "object-assign": "4.1.1",
    "process": "0.11.10",
    "react": "17.0.2",
    "react-beautiful-dnd": "13.1.0",
    "react-dom": "17.0.2",
    "react-dropzone": "11.7.1",
    "react-intersection-observer": "8.32.0",
    "react-intl": "5.24.8",
    "react-intl-redux": "2.4.1",
    "react-redux": "7.2.4",
    "react-router": "5.2.0",
    "react-router-dom": "5.2.0",
    "redux": "4.1.0",
    "redux-thunk": "2.3.0",
    "url-search-params-polyfill": "8.1.1",
    "whatwg-fetch": "3.6.2"
  },
  "devDependencies": {
    "@babel/cli": "7.24.1",
    "@babel/core": "7.24.3",
    "@babel/eslint-parser": "7.28.6",
    "@babel/node": "7.23.9",
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "@babel/plugin-transform-react-constant-elements": "7.24.1",
    "@babel/polyfill": "7.12.1",
    "@babel/preset-env": "7.24.3",
    "@babel/preset-react": "7.24.1",
    "@eslint/js": "9.39.5",
    "acorn": "8.11.3",
    "ajv": "8.6.0",
    "autoprefixer": "10.2.6",
    "babel-core": "7.0.0-bridge.0",
    "babel-jest": "27.5.1",
    "babel-loader": "8.2.4",
    "browser-sync": "3.0.2",
    "chalk": "4.1.2",
    "clean-webpack-plugin": "3.0.0",
    "connect-history-api-fallback": "1.6.0",
    "copy-webpack-plugin": "6.4.1",
    "coveralls": "3.1.0",
    "css-loader": "5.2.7",
    "cssnano": "5.0.6",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "file-loader": "6.2.0",
    "globals": "17.13.0",
    "history": "4.10.1",
    "html-webpack-plugin": "5.5.0",
    "jest": "27.5.1",
    "jest-cli": "27.5.1",
    "json-loader": "0.5.7",
    "mini-css-extract-plugin": "1.6.2",
    "node-sass": "9.0.0",
    "opn-cli": "4.1.0",
    "postcss": "8.3.5",
    "postcss-loader": "4.3.0",
    "prettier": "3.9.10",
    "prompt": "1.1.0",
    "puppeteer": "24.24.0",
    "react-hot-loader": "4.13.0",
    "redux-immutable-state-invariant": "2.1.0",
    "replace": "1.2.1",
    "rimraf": "3.0.2",
    "sass-loader": "10.5.2",
    "style-loader": "2.0.0",
    "url-loader": "4.1.1",
    "webpack": "5.91.0",
    "webpack-bundle-analyzer": "4.10.1",
    "webpack-dev-middleware": "3.7.3",
    "webpack-hot-middleware": "2.25.0"
  },
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "https://github.com/nthiebes/booky.io.git"
  }
}
